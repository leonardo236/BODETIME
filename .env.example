# Copia este archivo como .env y completa los valores de tu servidor MySQL 8.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bodetime
DB_USER=bodetime_app
DB_PASSWORD=cambia_esta_clave
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=5
DB_CREATE_SCHEMA=true
# BODETIME_ADMIN_PASSWORD_HASH se crea desde Configuración; no pegues aquí una contraseña.
